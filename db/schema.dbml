Table follows {
  following_user_id integer
  followed_user_id integer
  created_at timestamp
}

Table student {
  id integer [primary key]
  sam_account_name varchar
  registraire varchar
  emplid varchar
  oprid varchar
  password varchar
  profil_path varchar
  ou varchar
  city varchar
  id_student_edusign varchar
